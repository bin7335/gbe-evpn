@echo off
chcp 65001 >nul
powershell -NoProfile -ExecutionPolicy Bypass -Command "& { $target = Join-Path '%~dp0' 'EVPN_Edge_Launcher.cmd'; $workDir = '%~dp0'; $desktop = [Environment]::GetFolderPath('Desktop'); $lnk = Join-Path $desktop 'EVPN Dedicated Edge.lnk'; $wsh = New-Object -ComObject WScript.Shell; $sc = $wsh.CreateShortcut($lnk); $sc.TargetPath = $target; $sc.WorkingDirectory = $workDir; $edge = 'C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe'; if (-not (Test-Path $edge)) { $edge = 'C:\Program Files\Microsoft\Edge\Application\msedge.exe' }; $sc.IconLocation = $edge + ',0'; $sc.Description = '경북 EVPN 전용 엣지 및 인터넷 동시접속 가드'; $sc.Save(); $bytes = [System.IO.File]::ReadAllBytes($lnk); $bytes[0x15] = $bytes[0x15] -bor 0x20; [System.IO.File]::WriteAllBytes($lnk, $bytes); Write-Host '바탕화면 바로가기가 성공적으로 생성되었습니다 (관리자 권한 자동 적용)!' -ForegroundColor Green }"
pause
